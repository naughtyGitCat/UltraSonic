<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.0</Version>
    <SourceRevisionId>$(SourceRevisionId)</SourceRevisionId>
    <!-- Build-time OpenAPI doc gen boots the app; skip it (Swagger UI works at runtime). -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <!-- Windows build keeps the WinForms tray + iOS USB (AFC) device sync. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>agent.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Linux/headless build (Docker, self-host): local scan + ingest + image serve. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <Target Name="SetGitHash" BeforeTargets="GetAssemblyVersion" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <EmbeddedResource Include="agent.ico" />
  </ItemGroup>

  <!-- Cross-platform packages (scan, ingest, image convert, logging). -->
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.11.1" />
    <PackageReference Include="MetadataExtractor.NaughtyGitCat" Version="1.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <!-- Windows-only: iOS USB device pull over AFC. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Netimobiledevice" Version="1.1.1" />
  </ItemGroup>

  <!-- Windows-only sources (tray, AFC iOS device sync) excluded from the Linux build. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Services/TrayIconManager.cs" />
    <Compile Remove="Services/DeviceSyncAppleJob.cs" />
  </ItemGroup>

</Project>
