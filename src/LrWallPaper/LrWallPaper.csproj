<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <Version>1.3.0</Version>
    <SourceRevisionId>$(SourceRevisionId)</SourceRevisionId>
    <!-- Don't run the build-time OpenAPI doc generator (it boots the app and trips on a
         controller's ambiguous HTTP method). Swagger UI still works at runtime. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <!-- Windows build keeps the WinForms tray icon + legacy wallpaper/device code. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>master.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Linux/headless build (Docker, self-host, demo server) — no Windows UI. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <Target Name="SetGitHash" BeforeTargets="GetAssemblyVersion" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <EmbeddedResource Include="master.ico" />
  </ItemGroup>

  <!-- Cross-platform packages (Master core: web, sqlite, image convert, logging, MCP). -->
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.11.1" />
    <PackageReference Include="MetadataExtractor.NaughtyGitCat" Version="1.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.4" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.4.0-preview.3" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NPOCO" Version="5.7.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

  <!-- Windows-only packages: MTP (MediaDevices), iOS USB (Netimobiledevice), System.Drawing. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="MediaDevices" Version="1.10.0" />
    <PackageReference Include="Netimobiledevice" Version="1.1.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.4" />
    <PackageReference Include="System.Drawing.Primitives" Version="4.3.0" />
  </ItemGroup>

  <!-- Windows-only sources (tray, wallpaper, USB/MTP device sync) — all currently
       disabled in Program.cs; excluded from the Linux build so it compiles headless. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Services/MasterTrayIconManager.cs" />
    <Compile Remove="Services/WallPaperHelper.cs" />
    <Compile Remove="Services/BusinessJob.cs" />
    <Compile Remove="Helpers/WallpaperHelper.cs" />
    <Compile Remove="Jobs/SyncRemovableJob.cs" />
    <Compile Remove="Jobs/SyncAppleJob.cs" />
    <Compile Remove="Helpers/DeviceHelper.cs" />
  </ItemGroup>

</Project>
