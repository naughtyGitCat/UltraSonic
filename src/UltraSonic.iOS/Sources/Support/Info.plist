<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>UltraSonic</string>
	<key>CFBundleName</key>
	<string>UltraSonic</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- PhotoKit: required to read the camera roll. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>UltraSonic reads your camera roll so it can back up the photos and videos you captured to your home server.</string>

	<!-- Master is a plain-HTTP server on the LAN. NSAllowsLocalNetworking permits
	     cleartext HTTP to private/.local addresses without disabling ATS globally. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Opportunistic background catch-up sync (see BackgroundSync.swift). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.ultrasonic.ios.sync</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
</dict>
</plist>
